#!/usr/bin/env bash
# cleanmac — dispatcher: bash junk-cleanup OR Python subcommands.
# Legacy:  cleanmac [--dry-run] [--verbose] [--commit] [--app NAME]
# Python:  cleanmac [--dry-run|--commit] [--json] [--verbose] {app,dup,disk,mem,hidden} ...
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

KNOWN_SUBCOMMANDS="uninstall app dup disk mem hidden"

# Find the first non-flag arg to decide which engine to invoke.
# Anything starting with '-' is a flag (skip). Stops at '--' or a positional.
first_positional=""
for arg in "$@"; do
  case "$arg" in
    --) break ;;
    --*) continue ;;
    -*)  continue ;;
    *)   first_positional="$arg"; break ;;
  esac
done

# Legacy mode: no positional arg OR first positional isn't a subcommand.
if [[ -z "$first_positional" ]] || ! [[ " $KNOWN_SUBCOMMANDS " == *" $first_positional "* ]]; then
  exec "${HERE}/legacy_cleanmac.sh" "$@"
fi

# Python mode: forward ALL args.
PY="${HERE}/../py"
if [[ ! -d "${PY}/src/maccleaner" ]]; then
  echo "cleanmac: python package not found at ${PY}/src/maccleaner" >&2
  exit 1
fi

PYTHONPATH="${PY}/src" exec python3 -m maccleaner.cli "$@"